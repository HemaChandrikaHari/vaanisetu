# Keep real credentials in backend/.env; never commit that file.
APP_MODE=demo
SARVAM_API_KEY=
FRONTEND_ORIGINS=http://localhost:5173

# Exotel India telephony (leave blank until an Exotel account and ExoPhone are provisioned).
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_BASE_URL=https://api.in.exotel.com
# Public secure WebSocket endpoint; local localhost URLs will not work with Exotel.
EXOTEL_STREAM_URL=
EXOTEL_STATUS_CALLBACK_URL=

# Safety switch. Keep false until the live two-way translation media bridge is deployed and tested.
ENABLE_OUTBOUND_CALLS=false
MAX_CALL_SECONDS=300
