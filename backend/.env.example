# Keep real credentials in backend/.env; never commit that file.
APP_MODE=demo
SARVAM_API_KEY=
FRONTEND_ORIGINS=http://localhost:5173

# Exotel India Programmable Voice (leave blank until Exotel enables the account).
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_BASE_URL=https://api.exotel.com
EXOTEL_EXOML_BASE_URL=https://cpaas-api.in.exotel.com
# Public WSS media endpoint base, without the participant path suffix.
EXOTEL_STREAM_URL=
EXOTEL_STREAM_CONTENT_TYPE=audio/x-mulaw;rate=8000
EXOTEL_MEDIA_TOKEN=generate-a-long-random-secret
EXOTEL_AGENTSTREAM_PROTOCOL_VERIFIED=false

# Public HTTPS ExoML event endpoint. The AgentStream Legs API documentation
# currently specifies gRPC events, while the general ExoML docs specify HTTPS.
# Keep the verification flag false until Exotel confirms the transport for
# this account and confirms that this HTTPS endpoint is accepted by POST /legs.
EXOTEL_LEG_EVENT_ENDPOINT_URL=
EXOTEL_LEG_EVENT_ENDPOINT_VERIFIED=false
# Generate unique credentials and configure the same pair with Exotel support.
EXOTEL_EVENT_AUTH_USERNAME=
EXOTEL_EVENT_AUTH_PASSWORD=

EXOTEL_STATUS_CALLBACK_URL=
# Safety switch. Must remain false until Exotel confirms account access and
# a complete end-to-end PSTN translation test has passed.
ENABLE_OUTBOUND_CALLS=false
MAX_CALL_SECONDS=300
